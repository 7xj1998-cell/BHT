(setq imported-fails 0 imported-passes 0)
(defun ic (name ok) (if ok (setq imported-passes (1+ imported-passes)) (setq imported-fails (1+ imported-fails))) (princ (strcat "\n" (if ok "PASS INPUT " "FAIL INPUT ") name)))
(defun im (id x y km h / e)
  (setq e (entmakex (list '(0 . "POINT") (cons 10 (list x y 0.0)))))
  (bht:pt-write-xdata e id "INPUT-QA" "1" id y x 0.0 "COC_TIEU" "QA" "" "")
  (bht:obj-write id (list (cons "object_id" id) '("nhom" . "COC_TIEU") (cons "marker_km" km) (cons "marker_h" h) (cons "pt" id))) e)
