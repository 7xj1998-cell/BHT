(ic "revoked-explicit-pair-rejected" (= "LOI" (car (bht:api-field-pair "SIGN" "A" "HAND"))))
(bht:api-field-manual-control "HAND" "1")
(bht:api-field-input-use (cadr (bht:api-field-input-preview)))
(bht:obj-delete "KM")
(setq in 0)
(repeat 25
  (im (strcat "M" (itoa in)) (+ 1000.0 (* in 100.0)) 0.0 (itoa (+ 41 (fix (/ in 10)))) (itoa (rem in 10)))
  (setq in (1+ in)))
(setq snap (cadr (bht:api-field-input-preview)))
(ic "snapshot-longer-than-XRecord-chunk" (> (strlen snap) 1000))
