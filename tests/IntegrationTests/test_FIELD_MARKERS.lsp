(bht:api-field-pair "SIGN" "FA" "FB")
(setq rec (bht:set (bht:obj-read "SIGN") "sign_heading_mode" "FIELD_PERP"))
(fc "perpendicular-heading" (equal 0.0 (bht:kh-orientation-angle rec '(250.0 3.0 0.0)) 1e-6))
(bht:obj-write "SIGN" rec)
(bht:kh-free-apply "SIGN" '(250.0 5.0 0.0) 0.5 nil)
(defun field-transform (/ d) (setq d (entget (cdr (assoc "SIGN" (bht:tagged-pairs "INSERT" "BHT_KH" 1))))) (list (assoc 10 d) (assoc 41 d) (assoc 42 d) (assoc 43 d)))
