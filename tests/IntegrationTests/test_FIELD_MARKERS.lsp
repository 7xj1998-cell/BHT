(setq field-fails 0 field-passes 0)
(defun fc (name ok) (if ok (setq field-passes (1+ field-passes)) (setq field-fails (1+ field-fails))) (princ (strcat "\n" (if ok "PASS FIELD " "FAIL FIELD ") name)))
(defun fm (id x y km h / e)
